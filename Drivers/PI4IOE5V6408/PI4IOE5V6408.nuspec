<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>TekuSP.Drivers.PI4IOE5V6408</id>
    <title>TekuSP I2C Driver for PI4IOE5V6408 I/O Expander</title>
    <version>$version$</version>
    <!--<version>$version$</version>-->
    <authors>Richard "TekuSP" Torhan</authors>
    <owners>Richard "TekuSP" Torhan</owners>
    <license type="file">LICENSE.md</license>
    <projectUrl>https://github.com/TekuSP/Meteostanice-CSharp</projectUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <developmentDependency>false</developmentDependency>
    <description>
      Nuget Package for Nanoframework, used for: Pericom PI4IOE5V6408 8-bit I2C GPIO expander
    </description>
    <releaseNotes>
    </releaseNotes>
    <repository type="git" url="https://github.com/TekuSP/Meteostanice-CSharp" commit="$commit$" />
    <copyright>Copyright (c) Richard Torhan 2026</copyright>
    <tags>drivers i2c tekusp net netmf nf nanoframework PI4IOE5V6408</tags>
    <dependencies>
      <dependency id="TekuSP.Drivers.DriverBase" version="$version$" />
      <dependency id="TekuSP.Drivers.DriverBaseI2C" version="$version$" />
      <dependency id="TekuSP.Drivers.DriverBase.Interfaces.Gpio" version="$version$" />
      <dependency id="nanoFramework.CoreLibrary" version="1.17.11" />
      <dependency id="nanoFramework.System.Device.I2c" version="1.1.29" />
      <dependency id="nanoFramework.System.Device.Gpio" version="1.1.64" />
      <dependency id="nanoFramework.Runtime.Events" version="1.11.39" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\TekuSP.Drivers.PI4IOE5V6408.*" target="lib" />
    <file src="../../LICENSE.md" target="" />
  </files>
</package>