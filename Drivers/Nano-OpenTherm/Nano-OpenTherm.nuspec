<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>TekuSP.Drivers.Nano_OpenTherm</id>
    <title>TekuSP OpenTherm Driver</title>
    <version>$version$</version>
    <!--<version>$version$</version>-->
    <authors>Richard "TekuSP" Torhan</authors>
    <owners>Richard "TekuSP" Torhan</owners>
    <license type="file">LICENSE.md</license>
    <projectUrl>https://github.com/TekuSP/Meteostanice-CSharp</projectUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <developmentDependency>false</developmentDependency>
    <description>
      Nuget Package for Nanoframework, used for: OpenTherm communication
    </description>
    <releaseNotes>
    </releaseNotes>
    <repository type="git" url="https://github.com/TekuSP/Meteostanice-CSharp" commit="$commit$" />
    <copyright>Copyright (c) Richard Torhan 2025</copyright>
    <tags>drivers tekusp net netmf nf nanoframework OpenTherm OT Thermostat</tags>
    <dependencies>
      <dependency id="TekuSP.Drivers.DriverBase" version="$version$" />
      <dependency id="nanoFramework.CoreLibrary" version="1.17.11" />
      <dependency id="nanoFramework.Runtime.Events" version="1.11.32" />
      <dependency id="nanoFramework.Runtime.Native" version="1.7.11" />
      <dependency id="nanoFramework.System.Device.Gpio" version="1.1.57" />
      <dependency id="nanoFramework.System.Diagnostics.Stopwatch" version="1.2.862" />
      <dependency id="nanoFramework.System.Math" version="1.5.116" />
      <dependency id="UnitsNet.nanoFramework.ElectricCurrent" version="6.0.0-pre019" />
      <dependency id="UnitsNet.nanoFramework.Energy" version="6.0.0-pre019" />
      <dependency id="UnitsNet.nanoFramework.Power" version="6.0.0-pre019" />
      <dependency id="UnitsNet.nanoFramework.Pressure" version="6.0.0-pre019" />
      <dependency id="UnitsNet.nanoFramework.Ratio" version="6.0.0-pre019" />
      <dependency id="UnitsNet.nanoFramework.RelativeHumidity" version="6.0.0-pre019" />
      <dependency id="UnitsNet.nanoFramework.RotationalSpeed" version="6.0.0-pre019" />
      <dependency id="UnitsNet.nanoFramework.Temperature" version="6.0.0-pre019" />
      <dependency id="UnitsNet.nanoFramework.VolumeConcentration" version="6.0.0-pre019" />
      <dependency id="UnitsNet.nanoFramework.VolumeFlow" version="6.0.0-pre019" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\TekuSP.Drivers.Nano_OpenTherm.*" target="lib" />
    <file src="../../LICENSE.md" target="" />
  </files>
</package>