<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>TekuSP.Drivers.MHZ19B</id>
    <title>TekuSP UART Driver for Zhengzhou Winsen Electronics Technology Co., Ltd, Intelligent Infrared CO2 Module MH-Z19B</title>
    <version>$version$</version>
    <!--<version>$version$</version>-->
    <authors>Richard "TekuSP" Torhan</authors>
    <owners>Richard "TekuSP" Torhan</owners>
    <license type="file">LICENSE.md</license>
    <projectUrl>https://github.com/TekuSP/Meteostanice-CSharp</projectUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <developmentDependency>false</developmentDependency>
    <description>
      Nuget Package for Nanoframework, used for: Sensor Zhengzhou Winsen Electronics Technology Co., Ltd, Intelligent Infrared CO2 Module MH-Z19B
    </description>
    <releaseNotes>
    </releaseNotes>
    <repository type="git" url="https://github.com/TekuSP/Meteostanice-CSharp" commit="$commit$" />
    <copyright>Copyright (c) Richard Torhan 2025</copyright>
    <tags>drivers uart tekusp net netmf nf nanoframework MH-Z19B MHZ19B MHZ</tags>
    <dependencies>
      <dependency id="TekuSP.Drivers.DriverBase" version="$version$" />
      <dependency id="TekuSP.Drivers.DriverBase.Interfaces.CO2" version="$version$" />
      <dependency id="TekuSP.Drivers.DriverBaseUART" version="$version$" />
      <dependency id="nanoFramework.CoreLibrary" version="1.17.11" />
      <dependency id="nanoFramework.Runtime.Events" version="1.11.39" />
      <dependency id="nanoFramework.System.IO.Ports" version="1.1.142" />
      <dependency id="nanoFramework.System.IO.Streams" version="1.1.96" />
      <dependency id="nanoFramework.System.Math" version="1.5.116" />
      <dependency id="nanoFramework.System.Text" version="1.3.42" />
      <dependency id="UnitsNet.nanoFramework.Ratio" version="5.75.1" />
      <dependency id="UnitsNet.nanoFramework.VolumeConcentration" version="5.75.1" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\TekuSP.Drivers.MHZ19B.*" target="lib" />
    <file src="../../LICENSE.md" target="" />
  </files>
</package>