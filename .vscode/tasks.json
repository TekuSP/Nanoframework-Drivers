{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "nanoFramework: Build Solution",
			// The "command" property uses the `${command:}` variable to execute a specific VS Code command by its ID.
			"command": "${command:vscode-nanoframework.nfbuild}",
			// The "type" is "shell" which allows the command variable to be executed.
			"type": "shell",
			// The "problemMatcher" helps VS Code parse the build output for errors and warnings.
			// "$msCompile" is a good default for .NET-based projects.
			"problemMatcher": [
				"$msCompile"
			],
			// This "group" configuration makes this the default build task.
			// You can run it with the "Run Build Task" command or the Ctrl+Shift+B shortcut.
			"group": {
				"kind": "build",
				"isDefault": true
			},
			// The "presentation" options control how the integrated terminal is displayed when the task runs.
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false,
				"clear": true
			}
		}
	]
}